# data.gov.gr API token — request at https://data.gov.gr (free, per-user)
DATA_GOV_GR_TOKEN=

# YouTube Data API v3 key — Google Cloud console, enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Contact URL advertised in our User-Agent to public endpoints. Be reachable.
TINOS_CONTACT_URL=https://github.com/<you>/tinos-transparency

# Optional: blob store for PDFs (S3-compatible). Leave blank for local-only.
BLOB_ENDPOINT=
BLOB_BUCKET=
BLOB_ACCESS_KEY=
BLOB_SECRET_KEY=
